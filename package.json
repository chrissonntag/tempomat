{
  "name": "tempomat",
  "version": "2026.10.1",
  "description": "Tempo.io cloud CLI",
  "main": "./lib/index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p .",
    "test": "jest",
    "lint": "eslint --ext .ts src test",
    "prepack": "npm run build && oclif manifest",
    "postpack": "node -e \"require('fs').rmSync('oclif.manifest.json',{force:true})\"",
    "pack:tarballs": "oclif pack tarballs --no-xz --targets linux-x64,linux-arm64,darwin-x64,darwin-arm64,win32-x64,win32-arm64",
    "docs": "npm run build && oclif manifest && oclif readme --no-aliases --readme-path docs/commands.md && node -e \"require('fs').rmSync('oclif.manifest.json',{force:true})\"",
    "version": "npm run docs && git add docs/commands.md",
    "lint:fix": "eslint --fix --ext .ts src test"
  },
  "author": "Szymon Kozak @szymonkozak",
  "license": "MIT",
  "homepage": "https://github.com/chrissonntag/tempomat",
  "bugs": "https://github.com/chrissonntag/tempomat/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrissonntag/tempomat.git"
  },
  "bin": {
    "tempo": "bin/run"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "tempo",
    "tempo-cli",
    "cli",
    "tempo cloud",
    "tempo.io",
    "jira"
  ],
  "oclif": {
    "topics": {
      "alias": {
        "description": "manage issue key aliases"
      },
      "tracker": {
        "description": "manage issue time trackers"
      },
      "config": {
        "description": "show and change settings like the default work type"
      },
      "skill": {
        "description": "install and update the tempo skill for Claude Code"
      }
    },
    "commands": "./lib/commands",
    "bin": "tempo",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ],
    "helpOptions": {
      "hideAliasesFromRoot": true
    },
    "hooks": {
      "init": "./lib/hooks/init/updateNotice"
    }
  },
  "files": [
    "/bin",
    "/lib",
    "/skill",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@oclif/core": "^4.2.10",
    "@oclif/plugin-autocomplete": "^4.0.4",
    "@oclif/plugin-help": "^6.2.27",
    "@types/lodash": "^4.17.16",
    "axios": "^1.20.0",
    "chalk": "^3.0.0",
    "cli-table3": "^0.5.1",
    "cli-truncate": "^2.1.0",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.24.0",
    "@types/jest": "^25.2.3",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "oclif": "^6.0.8",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "tempomat": {
    "releases": "chrissonntag/tempomat"
  }
}
